#!/bin/bash
# LanPanel 生命周期：start / stop / status
#
# 权限设计（遵循飞牛「最小权限」建议）：
#   - 生命周期脚本以 root 运行（config/privilege: run-as=root），只做一件特权准备：
#     用 setcap 给程序授予 CAP_NET_RAW，使设备发现可以发送原始 ARP / ICMP；
#   - 服务进程通过 setpriv（或 runuser）降权到应用专用用户运行。
#   - 系统没有 setcap 时，设备发现自动退回「读取邻居表」方式，功能不受影响。
#
# 飞牛不会托管应用进程（崩溃后不会自动拉起），因此这里自带一个守护循环。

APPNAME="lanpanel"
APP_DIR="${TRIM_APPDEST:?缺少 TRIM_APPDEST：本脚本需由飞牛应用框架调用}"
VAR_DIR="${TRIM_PKGVAR:?缺少 TRIM_PKGVAR：本脚本需由飞牛应用框架调用}"
PORT="${TRIM_SERVICE_PORT:-3080}"
RUN_USER="${TRIM_USERNAME:-lanpanel}"
RUN_GROUP="${TRIM_GROUPNAME:-lanpanel}"

BIN="${APP_DIR}/bin/lanpanel"
DATA_DIR="${VAR_DIR}/data"
LOG_FILE="${VAR_DIR}/lanpanel.log"
PID_FILE="${VAR_DIR}/lanpanel.pid"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

# 日志超过 5MB 时轮转，避免长期运行占满空间
rotate_log() {
    if [ -f "${LOG_FILE}" ] && [ "$(stat -c %s "${LOG_FILE}" 2>/dev/null || echo 0)" -gt 5242880 ]; then
        mv -f "${LOG_FILE}" "${LOG_FILE}.1"
    fi
}

check_process() {
    kill -0 "$1" 2>/dev/null
}

status() {
    if [ -f "${PID_FILE}" ]; then
        local pid
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if [ -n "${pid}" ] && check_process "${pid}"; then
            return 0
        fi
        rm -f "${PID_FILE}"
    fi
    return 1
}

prepare() {
    mkdir -p "${DATA_DIR}"
    rotate_log
    # 数据目录归应用用户所有
    if id "${RUN_USER}" >/dev/null 2>&1; then
        chown -R "${RUN_USER}:${RUN_GROUP}" "${VAR_DIR}" 2>/dev/null
    fi
    chmod 0755 "${BIN}"
    # 授予原始套接字能力（升级后文件被替换，每次启动都重新设置）
    if command -v setcap >/dev/null 2>&1; then
        if setcap cap_net_raw+ep "${BIN}" 2>>"${LOG_FILE}"; then
            log_msg "已授予 CAP_NET_RAW，设备发现将使用原始 ARP"
        fi
    else
        log_msg "未找到 setcap（可安装 libcap2-bin），设备发现将使用邻居表方式"
    fi
}

# 守护循环：以应用用户运行程序，异常退出时按退避时间重启
supervise() {
    local delay=2
    local child=""
    trap 'if [ -n "${child}" ]; then kill -TERM "${child}" 2>/dev/null; wait "${child}" 2>/dev/null; fi; exit 0' TERM INT
    while true; do
        local started
        started=$(date +%s)
        if id "${RUN_USER}" >/dev/null 2>&1 && command -v setpriv >/dev/null 2>&1; then
            # setpriv 直接以应用用户身份执行程序，不额外保留 root 父进程
            setpriv --reuid="${RUN_USER}" --regid="${RUN_GROUP}" --init-groups -- \
                "${BIN}" -listen ":${PORT}" -data "${DATA_DIR}" >> "${LOG_FILE}" 2>&1 &
        elif id "${RUN_USER}" >/dev/null 2>&1 && command -v runuser >/dev/null 2>&1; then
            runuser -u "${RUN_USER}" -- "${BIN}" -listen ":${PORT}" -data "${DATA_DIR}" >> "${LOG_FILE}" 2>&1 &
        else
            "${BIN}" -listen ":${PORT}" -data "${DATA_DIR}" >> "${LOG_FILE}" 2>&1 &
        fi
        child=$!
        wait "${child}"
        local rc=$?
        child=""
        # 稳定运行超过 1 分钟后退避时间复位
        if [ $(( $(date +%s) - started )) -gt 60 ]; then
            delay=2
        fi
        log_msg "进程退出（代码 ${rc}），${delay} 秒后重启"
        sleep "${delay}"
        delay=$(( delay * 2 > 60 ? 60 : delay * 2 ))
    done
}

wait_ready() {
    local count=0
    while [ "${count}" -lt 20 ]; do
        if (exec 3<>"/dev/tcp/127.0.0.1/${PORT}") 2>/dev/null; then
            return 0
        fi
        status || return 1
        sleep 1
        count=$((count + 1))
    done
    return 0 # 启动较慢也视为成功，由状态检查兜底
}

start_process() {
    if status; then
        return 0
    fi
    if [ ! -x "${BIN}" ] && [ ! -f "${BIN}" ]; then
        echo "程序文件缺失：${BIN}" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
        return 1
    fi
    prepare
    log_msg "启动 LanPanel，端口 ${PORT}，数据目录 ${DATA_DIR}"
    supervise < /dev/null > /dev/null 2>&1 &
    echo "$!" > "${PID_FILE}"
    if wait_ready; then
        log_msg "LanPanel 已启动"
        return 0
    fi
    log_msg "LanPanel 启动失败，请查看日志 ${LOG_FILE}"
    echo "LanPanel 启动失败，请查看日志：${LOG_FILE}" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
    rm -f "${PID_FILE}"
    return 1
}

stop_process() {
    if ! status; then
        return 0
    fi
    local pid
    pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
    log_msg "停止 LanPanel（守护进程 ${pid}）"
    kill -TERM "${pid}" 2>/dev/null
    local count=0
    while check_process "${pid}" && [ "${count}" -lt 10 ]; do
        sleep 1
        count=$((count + 1))
    done
    if check_process "${pid}"; then
        kill -KILL "${pid}" 2>/dev/null
        pkill -KILL -f "${BIN} -listen" 2>/dev/null
    fi
    rm -f "${PID_FILE}"
    return 0
}

case "$1" in
start)
    start_process
    exit $?
    ;;
stop)
    stop_process
    exit $?
    ;;
status)
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
