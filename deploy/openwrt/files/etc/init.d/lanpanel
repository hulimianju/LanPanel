#!/bin/sh /etc/rc.common
# LanPanel 服务（procd 托管，崩溃后自动重启）

START=99
STOP=10
USE_PROCD=1
PROG=/usr/bin/lanpanel

start_service() {
	config_load lanpanel
	local enabled listen data
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0
	config_get listen main listen ':3080'
	config_get data main data '/etc/lanpanel'
	mkdir -p "$data"

	procd_open_instance
	procd_set_param command "$PROG" -listen "$listen" -data "$data"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger lanpanel
}
